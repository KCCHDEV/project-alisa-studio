{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Project Alisa Studio V2",
  "version": "2.0.2",
  "identifier": "com.project.alisa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3050",
    "beforeDevCommand": "bun scripts/desktop-dev.ts",
    "beforeBuildCommand": "bun run build && bun run build:server"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Alisa Studio V2 — AI Coding Studio",
        "width": 1300,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "./dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    },
    "windows": {
      "nsis": {
        "headerImage": "./nsis-header.bmp",
        "sidebarImage": "./nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
