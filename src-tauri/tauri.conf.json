{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Project Alisa Studio V2",
  "version": "2.0.0",
  "identifier": "com.project.alisa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3050",
    "beforeDevCommand": "bun scripts/desktop-dev.ts",
    "beforeBuildCommand": "bun run build && bun run build:server"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Alisa Studio V2 — AI Coding Studio",
        "width": 1300,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ]
  }
}
