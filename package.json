{
  "name": "project-alisa",
  "version": "1.0.0",
  "description": "Project Alisa Studio \u0e42\u20ac\u201d Personal AI Coding & Automation Harness",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --kill-others-on-fail \"bun run src/server/index.ts\" \"bun run dev\"",
    "build:ui": "vite build",
    "build": "bun run typecheck && bun run build:ui",
    "preview": "vite preview",
    "server": "bun run src/server/index.ts",
    "cli": "bun run src/cli/index.ts",
    "start": "bun run dev:all",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dist": "bun run tauri:build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:server": "bun run scripts/build-server.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  }
}
